# Префикс Docker-реестра. Замените на ваш GitHub username.
# Пример: ghcr.io/nugumanov
REGISTRY_PREFIX=ghcr.io/YOUR_GITHUB_USERNAME

# Credentials для PostgreSQL
DB_USERNAME=pricetracker
DB_PASSWORD=change_me_to_a_strong_password

# Telegram Bot Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=change_me_to_your_bot_token

# Cron-расписание парсера цен (по умолчанию каждые 6 часов)
# Должно запускаться раньше NOTIFIER_CRON
COLLECTOR_CRON=0 0 */6 * * *

# Cron-расписание отправки уведомлений (по умолчанию каждые 6 часов)
NOTIFIER_CRON=0 0 */6 * * *
